        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "multigeometri"
            },
            "position": {
              "$ref": "https://geojson.org/schema/GeometryCollection.json"
            }
          }
        }
      ]
    },
    "koordinatsystemPlan": {
      "type": "string",
      "enum": [
        "EPSG:3006",
        "EPSG:3007",
        "EPSG:3008",
        "EPSG:3009",
        "EPSG:3010",
        "EPSG:3011",
        "EPSG:3012",
        "EPSG:3013",
        "EPSG:3014",
        "EPSG:3015",
        "EPSG:3016",
        "EPSG:3017",
        "EPSG:3018"
      ]
    },
    "dimension": {
      "type": "integer",
      "enum": [
        2,
        3
      ]
    }
  }
}