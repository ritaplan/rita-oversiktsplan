{
  "$id": "https://namespace.lantmateriet.se/distribution/geodatakatalog/geometri/geometri-2.0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geometri 2.0.1",
  "oneOf": [
    {
      "$ref": "#/$defs/punkt"
    },
    {
      "$ref": "#/$defs/linje"
    },
    {
      "$ref": "#/$defs/yta"
    },
    {
      "$ref": "#/$defs/kropp"
    },
    {
      "$ref": "#/$defs/multipunkt"
    },
    {
      "$ref": "#/$defs/multilinje"
    },
    {
      "$ref": "#/$defs/multiyta"
    },
    {
      "$ref": "#/$defs/multikropp"
    },
    {
      "$ref": "#/$defs/multigeometri"
    }
  ],
  "$defs": {
    "geometri": {
      "type": "object",
      "properties": {
        "typ": {
          "type": "string"
        },
        "absolutLagesosakerhetPlan": {
          "type": "number"
        },
        "absolutLagesosakerhetHojd": {
          "type": "number"
        },
        "koordinatsystemPlan": {
          "$ref": "#/$defs/koordinatsystemPlan"
        },
        "hojdsystem": {
          "const": "EPSG:5613"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        }
      },
      "required": [
        "typ",
        "koordinatsystemPlan",
        "dimension"
      ]
    },
    "punkt": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "punkt"
            },
            "position": {
              "$ref": "https://geojson.org/schema/Point.json"
            }
          }
        }
      ]
    },
    "linje": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "linje"
            },
            "position": {
              "$ref": "https://geojson.org/schema/LineString.json"
            }
          }
        }
      ]
    },
    "yta": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "yta"
            },
            "position": {
              "$ref": "https://geojson.org/schema/Polygon.json"
            }
          }
        }
      ]
    },
    "kropp": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "kropp"
            },
            "position": {
              "$ref": "https://geojson.org/schema/MultiPolygon.json"
            }
          }
        }
      ]
    },
    "multipunkt": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "multipunkt"
            },
            "position": {
              "$ref": "https://geojson.org/schema/MultiPoint.json"
            }
          }
        }
      ]
    },
    "multilinje": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "multilinje"
            },
            "position": {
              "$ref": "https://geojson.org/schema/MultiLineString.json"
            }
          }
        }
      ]
    },
    "multiyta": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "multiyta"
            },
            "position": {
              "$ref": "https://geojson.org/schema/MultiPolygon.json"
            }
          }
        }
      ]
    },
    "multikropp": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/geometri"
        },
        {
          "properties": {
            "typ": {
              "const": "multikropp"
            },
            "position": {
              "$ref": "https://geojson.org/schema/GeometryCollection.json"
            }
